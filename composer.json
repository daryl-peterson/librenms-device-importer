{
    "name": "daryl-peterson/librenms-device-importer",
    "description": "LibreNMS plugin for importing devices from csv.",
    "keywords": [
        "librenms",
        "plugin",
        "plugin device",
        "importer",
        "csv"
    ],
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "Daryl Peterson"
        }
    ],
    "require": {
        "php": "^8.2",
        "librenms/plugin-interfaces": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "DRP\\DeviceImporter\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DRP\\DeviceImporter\\PluginProvider"
            ],
            "aliases": {
                "DeviceImporter": "DRP\\DeviceImporter\\Facades\\DeviceImporterFacade"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
